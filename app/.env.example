# ============ OMNIFETCH — configuração ============
# Copie este arquivo para .env e ajuste se quiser.
# Todos os valores são opcionais — o app funciona sem .env.

# Porta do servidor local
PORT=4777

# Host. 127.0.0.1 = apenas este computador (recomendado).
# Para acessar do celular na mesma rede, use LAN_MODE=true (abaixo).
HOST=127.0.0.1

# true = expõe o servidor na rede local (LAN) para usar pelo celular.
# Nunca exponha para a internet.
LAN_MODE=false

# Pasta onde os downloads serão salvos.
# Padrão: <sua pasta de usuário>/Downloads/OMNIFETCH
DOWNLOAD_DIR=

# Caminhos manuais para os binários (se não estiverem no PATH nem em ./bin)
YTDLP_PATH=
FFMPEG_PATH=

# Downloads simultâneos (1 a 6)
MAX_CONCURRENT=2

# true = não abre o navegador automaticamente ao iniciar
NO_OPEN=false

# ⚠ Apenas para redes com inspeção TLS (proxy corporativo/antivírus que
# reassina certificados). Se a análise falhar com CERTIFICATE_VERIFY_FAILED,
# ative. Isso desliga a verificação de certificados do yt-dlp.
ALLOW_INSECURE_SSL=false
